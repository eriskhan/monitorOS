#!/usr/bin/env bash
set -euo pipefail

ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

VERSION="$(
    awk '
        $0 == "[workspace.package]" { in_package = 1; next }
        /^\[/ { in_package = 0 }
        in_package && $1 == "version" && $2 == "=" {
            gsub(/"/, "", $3)
            print $3
            found = 1
            exit
        }
        END { if (!found) exit 1 }
    ' "$ROOT/Cargo.toml"
)" || {
    echo "error: Cargo.toml does not define [workspace.package] version" >&2
    exit 1
}

[[ "$VERSION" =~ ^[0-9]+\.[0-9]+\.[0-9]+$ ]] || {
    echo "error: invalid monitorOS version: $VERSION" >&2
    exit 1
}

printf '%s\n' "$VERSION"
